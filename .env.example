# Driftsync works fully on-device with no environment variables.
# To turn on accounts + sync, fill these in (see docs/supabase.md). In Vercel, add them under
# Settings → Environment Variables, then redeploy (they're baked in at build time).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). Safe to expose: row-level security protects the data.
# Older projects can use the legacy anon key via NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Never put the secret / service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional extra sign-in buttons (enable them in Supabase first): google,github,apple,azure,discord,gitlab
NEXT_PUBLIC_SUPABASE_PROVIDERS=
