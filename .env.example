# Driftsync runs fully locally with no env vars.
# Storage backend: "local" (default) or "supabase" (stub, not implemented yet).
NEXT_PUBLIC_DRIFTSYNC_STORAGE=local

# Supabase (see README "Connecting Supabase (with login)" and supabase/schema.sql).
# Both values are safe to expose in the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
